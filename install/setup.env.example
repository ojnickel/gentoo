# Personal defaults for setup.sh - COPY THIS FILE, DO NOT COMMIT THE COPY.
#
#   cp setup.env.example setup.env
#   chmod 600 setup.env
#   $EDITOR setup.env
#
# setup.env is in .gitignore. Without it every personal field below starts
# out empty and setup.sh asks for it.
#
# Anything set here becomes the DEFAULT in the prompt - you can still type
# over it. Set UNATTENDED=1 to accept them all without being asked.
#
# This file is sourced by bash. Put every value in SINGLE quotes if it
# contains a $, a space or any other shell character - otherwise bash expands
# it. This matters most for password hashes, which are full of $:
#     CFG_ROOT_PW='$6$salt$digest'     correct
#     CFG_ROOT_PW=$6$salt$digest       WRONG - bash eats it, ends up empty

# ---------- Identity ----------
CFG_HOSTNAME=
CFG_USER=

# ---------- Locale and keyboard ----------
CFG_TZONE=
CFG_LANG=
CFG_KBD=
CFG_CONSKBD=

# ---------- Choices (these keep working defaults if left empty) ----------
# CFG_SHELL      bash | fish | zsh          (default: bash)
# CFG_DESKTOP    sway | none                (default: sway)
# CFG_PROFILE    plain | desktop            (default: plain)
CFG_SHELL=
CFG_DESKTOP=
CFG_PROFILE=

# ---------- Passwords ----------
# Leave BOTH empty to be prompted interactively at the end - that is the
# safest option and means no password is ever written to disk.
#
# If you do set them, prefer a HASH over a plaintext password. A value that
# starts with '$' is passed to "chpasswd -e" as an already-hashed password.
# Generate one with:
#     openssl passwd -6
#     # or:  mkpasswd --method=yescrypt
# and wrap the result in SINGLE quotes (see the note above).
#
# setup.sh never prints or logs these, and deletes /root/setup.env from the
# installed system once it finishes successfully.
CFG_ROOT_PW=
CFG_USER_PW=

# ---------- Unattended ----------
# 1 = never ask anything, just use the values above.
UNATTENDED=
