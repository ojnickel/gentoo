# Gentoo
abbr -a world "emerge -avDN world"
abbr -a freemem "sync; echo 3 > /proc/sys/vm/drop_caches"
abbr -a rebuild "emerge -av @preserved-rebuild"
abbr -a i "emerge -av"
abbr -a r "emerge -Cav"
abbr -a dp "emerge -cav"

# Files
abbr -a l "eza -alg"
abbr -a lsa "eza -algT"
abbr -a ld "eza -algDs size"

# General
abbr -a x "exit"
